# -*- mode: rpm-spec-mode; encoding: utf-8; -*-
# Pass '--without docs' to rpmbuild if you don't want the documentation to be build

Summary: 	Cra: text-mode interface for Arc
Name: 		cra
Version: 	@@VERSION@@
Release: 	@@RELEASE@@%{?dist}
License: 	GPLv2+
Group: 		Development/Tools
Vendor: 	Jonas Fonseca <jonas.fonseca@gmail.com>
URL: 		https://github.com/themiron/cra
Source: 	%{name}-%{version}.tar.gz
BuildRequires: 	ncurses-devel%{!?_without_docs:, xmlto, asciidoc > 6.0.3}
BuildRoot: 	%{_tmppath}/%{name}-%{version}-%{release}-root-%(%{__id_u} -n)
Requires: 	ncurses

%description
Cra is an Arc repository browser that can also act as a pager. It presents
history, commit diffs, trees, blobs, blame, references, and status views.

Using it as a pager, it will display input from stdin and colorize it.

%prep
%setup -q

%build
%configure
CRA_CFLAGS="$RPM_OPT_FLAGS"
%{__make} %{_smp_mflags} \
	prefix=%{_prefix} \
	all %{!?_without_docs: doc-man doc-html}

%install
[ "$RPM_BUILD_ROOT" != "/" ] && rm -rf $RPM_BUILD_ROOT
CRA_CFLAGS="$RPM_OPT_FLAGS"
%{__make} %{_smp_mflags} DESTDIR=$RPM_BUILD_ROOT \
	prefix=%{_prefix} bindir=%{_bindir} mandir=%{_mandir} \
	install %{!?_without_docs: install-doc-man}

%clean
[ "$RPM_BUILD_ROOT" != "/" ] && rm -rf $RPM_BUILD_ROOT

%files
%defattr(-,root,root)
%{_bindir}/*
%{_sysconfdir}/*
%doc README.adoc COPYING INSTALL.adoc NEWS.adoc contrib/cra-completion.bash contrib/cra-completion.zsh
%{!?_without_docs: %{_mandir}/man1/*.1*}
%{!?_without_docs: %{_mandir}/man5/*.5*}
%{!?_without_docs: %{_mandir}/man7/*.7*}
%{!?_without_docs: %doc doc/*.html}
%{?_without_docs:  %doc doc/*.txt}

